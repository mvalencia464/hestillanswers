---
import Signup from '../components/Signup.astro';
interface Props { title: string; description?: string; image?: string; noindex?: boolean; signup?: boolean }
const { title, description = 'True stories of answered prayer from the last 300 years, and old words that still burn.', image, noindex = false, signup = true } = Astro.props;
const full = title === 'He Still Answers' ? 'He Still Answers · True stories of answered prayer' : `${title} · He Still Answers`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = image || new URL('/og-default.jpg', Astro.site).href;
const nav = [['/stories/', 'Stories'], ['/prayers/', 'Prayers'], ['/words/', 'Old Words'], ['/verses/', 'Verses'], ['/questions/', 'Questions']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="article" />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preload" href="/fonts/Lora-Variable.ttf" as="font" type="font/ttf" crossorigin />
</head>
<body>
  <header class="top">
    <a class="brand" href="/"><img src="/favicon.png" alt="" width="34" height="34" /><span>He Still Answers</span></a>
    <nav>{nav.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}</a>)}</nav>
    <a class="cta" href="/free-ebook/">Free ebook</a>
  </header>
  <main><slot /></main>
  {signup && <section class="signup-band"><Signup /></section>}
  <footer>
    <p><strong>He Still Answers</strong> · True stories of answered prayer</p>
    <p>Stories retold from <em>The Wonders of Prayer</em> (1885) and the <em>New Cyclopaedia of Prose Illustrations</em> (1875). Prayers and lines of C. H. Spurgeon and Matthew Henry. All source books are in the public domain.</p>
    <p><a href="/about/">About</a> · <a href="/privacy/">Privacy</a> · <a href="/free-ebook/">Free ebook</a></p>
  </footer>
</body>
</html>
<style is:global>
  @font-face { font-family: 'Poppins'; src: url('/fonts/Poppins-ExtraBold.ttf') format('truetype'); font-weight: 800; font-display: swap; }
  @font-face { font-family: 'Poppins'; src: url('/fonts/Poppins-Bold.ttf') format('truetype'); font-weight: 700; font-display: swap; }
  @font-face { font-family: 'Poppins'; src: url('/fonts/Poppins-SemiBold.ttf') format('truetype'); font-weight: 600; font-display: swap; }
  @font-face { font-family: 'Lora'; src: url('/fonts/Lora-Variable.ttf') format('truetype'); font-weight: 400 700; font-display: swap; }
  @font-face { font-family: 'Lora'; src: url('/fonts/Lora-Italic-Variable.ttf') format('truetype'); font-weight: 400 700; font-style: italic; font-display: swap; }
  :root { --ink: #0a0d14; --ink2: #161b26; --gold: #f6b728; --gold-dk: #9a6a08; --parch: #fff6e6; --paper: #fbf7ef; --muted: #6b6457; --line: #e7dcc6; }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--paper); color: #1d1b17; font: 400 1.125rem/1.7 'Lora', Georgia, serif; }
  a { color: inherit; }
  img { max-width: 100%; height: auto; display: block; }
  h1, h2, h3, .kicker, nav, .cta, .btn, label, .meta { font-family: 'Poppins', system-ui, sans-serif; }
  .top { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 1.25rem; padding: .7rem clamp(1rem, 4vw, 2.5rem); background: var(--ink); color: #fff; }
  .brand { display: flex; align-items: center; gap: .55rem; text-decoration: none; font: 800 1.02rem 'Poppins', sans-serif; letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }
  .brand img { border-radius: 50%; }
  .top nav { display: flex; gap: 1.1rem; margin-left: auto; font-size: .86rem; font-weight: 600; overflow-x: auto; scrollbar-width: none; }
  .top nav a { text-decoration: none; opacity: .8; white-space: nowrap; }
  .top nav a:hover, .top nav a[aria-current] { opacity: 1; color: var(--gold); }
  .cta { background: var(--gold); color: var(--ink); text-decoration: none; font-weight: 700; font-size: .82rem; padding: .45rem .9rem; border-radius: 999px; white-space: nowrap; }
  @media (max-width: 760px) { .top { flex-wrap: wrap; gap: .5rem 1rem; } .top nav { order: 3; width: 100%; margin: 0; } .cta { margin-left: auto; } }
  main { min-height: 60vh; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2.5rem); }
  .narrow { max-width: 680px; margin: 0 auto; padding: 0 1.25rem; }
  .kicker { font-size: .78rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--gold-dk); }
  h1 { font-weight: 800; line-height: 1.15; letter-spacing: -.01em; }
  .btn { display: inline-block; background: var(--gold); color: var(--ink); font-weight: 700; text-decoration: none; padding: .8rem 1.4rem; border-radius: 999px; border: 0; font-size: 1rem; cursor: pointer; }
  .btn.dark { background: var(--ink); color: #fff; }
  .signup-band { background: var(--ink); color: #fff; padding: 3.5rem 1.25rem; margin-top: 4rem; }
  footer { background: #05070b; color: #b9b2a3; font-size: .92rem; padding: 2.5rem clamp(1rem, 4vw, 2.5rem); }
  footer p { max-width: 760px; margin: .4rem auto; text-align: center; }
  footer a { color: #e9e2d2; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 1.4rem; }
</style>
