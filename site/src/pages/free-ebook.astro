---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
---
<Base title="Free ebook: 30 True Stories of Answered Prayer" description="A free ebook of thirty true accounts of answered prayer, recorded in the 1800s and quoted from the old books." signup={false}>
  <section class="eb">
    <div class="wrap two">
      <img src="/ebook/cover.jpg" alt="Cover of 30 True Stories of Answered Prayer" width="900" height="1350" />
      <div>
        <p class="kicker">Free ebook</p>
        <h1>30 True Stories of Answered Prayer</h1>
        <p>A widow's last pint of cornmeal. A ship that would not move for six days. A thief who left the sleigh at an inn forty miles away. Thirty accounts, written down by the people who lived them, and quoted word for word from the old books where the original could be recovered cleanly.</p>
        <ul><li>30 stories, most of them quoted word for word from the 1885 accounts</li><li>Where every account was first recorded</li><li>A PDF to read on any phone, tablet or computer, or to print</li></ul>
        <Signup compact />
      </div>
    </div>
  </section>
</Base>
<style>
  .eb { background: var(--ink); color: #fff; padding: 3.5rem 0 4rem; }
  .two { display: grid; grid-template-columns: minmax(200px, 340px) 1fr; gap: clamp(1.5rem, 5vw, 3.5rem); align-items: center; }
  .two img { border-radius: 8px; box-shadow: 0 20px 60px -20px #000; }
  .kicker { color: var(--gold); } h1 { font-size: clamp(2rem, 5vw, 3rem); margin: .3rem 0 1rem; }
  p, li { color: #ddd5c6; } ul { margin: 0 0 1.6rem; padding-left: 1.2rem; }
  @media (max-width: 700px) { .two { grid-template-columns: 1fr; } .two img { max-width: 240px; margin: 0 auto; } }
</style>
