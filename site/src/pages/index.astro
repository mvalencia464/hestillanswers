---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { bySection, SECTIONS, type Section } from '../lib/posts';
const stories = bySection('stories').filter((e) => e.images.length).slice(0, 12);
const counts = (Object.keys(SECTIONS) as Section[]).map((s) => [s, SECTIONS[s].name, bySection(s).length] as const);
---
<Base title="He Still Answers">
  <section class="hero">
    <div class="wrap">
      <p class="kicker">True stories of answered prayer</p>
      <h1>He still answers.</h1>
      <p class="lede">A widow who put the kettle on with nothing in the house. A captain who turned his ship one point in the night. A pastor whose answer was already in his unopened mail. These accounts were written down in the 1800s by people who saw them happen. Here they are again, in plain English, with the prayers of Spurgeon and Matthew Henry beside them.</p>
      <p><a class="btn" href="/stories/">Read the stories</a> <a class="btn ghost" href="/free-ebook/">Get the free ebook</a></p>
    </div>
  </section>
  <section class="wrap">
    <div class="head"><h2>Stories</h2><a href="/stories/">All {bySection('stories').length} stories →</a></div>
    <div class="grid">{stories.map((e) => <Card e={e} />)}</div>
  </section>
  <section class="wrap sections">
    {counts.filter(([s]) => s !== 'stories').map(([s, name, n]) => (
      <a href={`/${s}/`} class="sec"><span class="n">{n}</span><span class="nm">{name}</span><span class="b">{SECTIONS[s].blurb}</span></a>
    ))}
  </section>
</Base>
<style>
  .hero { background: var(--ink); color: #fff; padding: clamp(3rem, 9vw, 6rem) 0 clamp(2.5rem, 7vw, 4.5rem); margin-bottom: 3rem; }
  .hero .kicker { color: var(--gold); }
  .hero h1 { font-size: clamp(2.6rem, 8vw, 5rem); margin: .3rem 0 1rem; }
  .hero .lede { max-width: 640px; color: #d8d1c3; font-size: 1.15rem; }
  .btn.ghost { background: transparent; color: #fff; box-shadow: inset 0 0 0 2px #fff6; margin-left: .4rem; }
  .head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1.2rem; }
  .head h2 { font-size: 1.6rem; margin: 0; }
  .head a { font: 600 .9rem 'Poppins', sans-serif; color: var(--gold-dk); text-decoration: none; }
  .sections { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 3.5rem; }
  .sec { display: flex; flex-direction: column; gap: .25rem; padding: 1.4rem; border-radius: 12px; background: #fff; border: 1px solid var(--line); text-decoration: none; }
  .sec:hover { border-color: var(--gold); }
  .n { font: 800 2rem 'Poppins', sans-serif; color: var(--gold-dk); line-height: 1; }
  .nm { font: 700 1.1rem 'Poppins', sans-serif; }
  .b { font-size: .95rem; color: var(--muted); line-height: 1.5; }
</style>
