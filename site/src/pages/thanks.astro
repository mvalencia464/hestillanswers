---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you" noindex signup={false}>
  <section class="narrow ty">
    <p class="kicker">You're in</p>
    <h1>Thank you. Your ebook is ready.</h1>
    <p>We've also sent a copy to your inbox. If it isn't there in a few minutes, check your spam or promotions folder.</p>
    <p><a class="btn dark" href="/ebook/30-true-stories-of-answered-prayer.pdf" download>Download the ebook (PDF)</a></p>
    <p>Then come back any time for <a href="/stories/">more stories</a>.</p>
  </section>
</Base>
<style>.ty { padding: 4rem 1.25rem; } h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); }</style>
